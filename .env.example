# =========================================================================
# ROOT ENVIRONMENT VARIABLES CONFIGURATION (.env)
# This file is used primarily by Docker Compose and the n8n agent containers.
# Copy this to .env in the same directory: cp .env.example .env
# =========================================================================

# OpenAI API Key used for some workflows (optional fallback)
OPENAI_API_KEY=your-openai-api-key-here

# CIT Cluster API Key for the TUM CIT inference server
CLUSTER_API_KEY=your-cluster-api-key-here

# Gemini API Key used for generating vector embeddings
GEMINI_API_KEY=your-gemini-api-key-here

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jPASSWORD

# Base URL for the specialist LLM inference cluster
INFERENCE_BASE_URL=http://131.159.60.153:3000/inference

# Webhook endpoint URL for the n8n data ingestion workflow
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trigger-extraction

# Directory where uploaded files are stored temporarily/for processing
UPLOAD_DIR=./data-processors

# Express Backend Server Port
PORT=8000

# MCP Transport configuration: "stdio" or "sse"
MCP_TRANSPORT=sse

    {
      "parameters": {
        "jsCode": "const question = $(\"Normalize Chat Input\").first().json.question || \"\";\nconst sessionId = $(\"Normalize Chat Input\").first().json.sessionId || \"default-session\";\nconst selectedAgents = $(\"Route Question\").first().json.selectedAgents || [];\n\nfunction getNodeJson(nodeName) {\n  try {\n    return $(nodeName).first().json;\n  } catch (e) {\n    return {\n      agent: nodeName,\n      status: \"error\",\n      answer: `Could not read output from ${nodeName}`,\n      keyFindings: [],\n      recommendations: [],\n      confidence: \"low\",\n      error: e.message,\n    };\n  }\n}\n\nconst procurement = getNodeJson(\"Run Procurement Specialist\");\nconst risk = getNodeJson(\"Run Risk Analyst\");\nconst logistics = getNodeJson(\"Run Logistics Specialist\");\nconst sustainability = getNodeJson(\"Run Sustainability Analyst\");\nconst quality = getNodeJson(\"Run Quality Analyst\");\n\nconst allSpecialistResults = [\n  procurement,\n  risk,\n  logistics,\n  sustainability,\n  quality,\n].filter(Boolean);\n\nconst specialistResults = allSpecialistResults.filter(\n  (result) => result.status !== \"skipped\"\n);\n\nreturn [\n  {\n    json: {\n      question,\n      sessionId,\n      selectedAgents,\n      specialistResults,\n      allSpecialistResults,\n      timestamp: new Date().toISOString(),\n    },\n  },\n];"
      },

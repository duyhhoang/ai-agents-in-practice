    {
      "parameters": {
        "jsCode": "const question = $json.question || \"\";\nconst q = question.toLowerCase();\n\nconst selectedAgents = [];\n\nconst procurementKeywords = [\n  \"supplier\",\n  \"suppliers\",\n  \"purchase order\",\n  \"po\",\n  \"procurement\",\n  \"sourcing\",\n  \"vendor\",\n  \"lead time\",\n  \"material\",\n  \"materials\"\n];\n\nconst riskKeywords = [\n  \"risk\",\n  \"risky\",\n  \"delay\",\n  \"delayed\",\n  \"bottleneck\",\n  \"critical\",\n  \"failure\",\n  \"incident\",\n  \"audit\",\n  \"maintenance\"\n];\n\nconst logisticsKeywords = [\n  \"shipment\",\n  \"shipping\",\n  \"transport\",\n  \"route\",\n  \"delivery\",\n  \"freight\",\n  \"warehouse\",\n  \"location\",\n  \"logistics\"\n];\n\nconst sustainabilityKeywords = [\n  \"carbon\",\n  \"emission\",\n  \"emissions\",\n  \"co2\",\n  \"recycling\",\n  \"waste\",\n  \"sustainability\",\n  \"environment\",\n  \"environmental\"\n];\n\nconst qualityKeywords = [\n  \"quality\",\n  \"test\",\n  \"testing\",\n  \"defect\",\n  \"inspection\",\n  \"audit\",\n  \"report\"\n];\n\nconst runProcurement = procurementKeywords.some(k => q.includes(k));\nconst runRisk = riskKeywords.some(k => q.includes(k));\nconst runLogistics = logisticsKeywords.some(k => q.includes(k));\nconst runSustainability = sustainabilityKeywords.some(k => q.includes(k));\nconst runQuality = qualityKeywords.some(k => q.includes(k));\n\nif (runProcurement) selectedAgents.push(\"procurement_specialist\");\nif (runRisk) selectedAgents.push(\"risk_analyst\");\nif (runLogistics) selectedAgents.push(\"logistics_specialist\");\nif (runSustainability) selectedAgents.push(\"sustainability_analyst\");\nif (runQuality) selectedAgents.push(\"quality_analyst\");\n\n// fallback: if nothing matches, run manager with general context later\nif (selectedAgents.length === 0) {\n  selectedAgents.push(\"procurement_specialist\", \"risk_analyst\");\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      selectedAgents,\n      runProcurement,\n      runRisk,\n      runLogistics,\n      runSustainability,\n      runQuality,\n    },\n  },\n];"
      },

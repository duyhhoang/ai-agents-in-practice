# =========================================================================
# MCP SERVER ENVIRONMENT VARIABLES (mcp-server/.env)
# Used by the Express / MCP backend server.
# Copy this to .env in the same directory: cp .env.example .env
# =========================================================================

PORT=8000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jPASSWORD

# API key and base URL of the OpenAI-compatible LLM inference server (TUM CIT cluster)
CLUSTER_API_KEY=your-cluster-api-key-here
INFERENCE_BASE_URL=http://131.159.60.153:3000/inference

# Directory where uploaded files are stored for processing
UPLOAD_DIR=../data-processors
N8N_WEBHOOK_URL=http://localhost:5678/webhook/trigger-extraction

# Optional: Gemini API key for embeddings. Leave empty to use the deterministic local fallback.
GEMINI_API_KEY=

# MCP transport: "sse" (HTTP, default) or "stdio"
MCP_TRANSPORT=sse
